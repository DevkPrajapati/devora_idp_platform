# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s

# Database
DATABASE_URL=postgres://idp:idp_dev_password@localhost:5434/idp?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# Auth (Keycloak)
AUTH_ISSUER=http://localhost:8080/realms/idp
AUTH_AUDIENCE=idp-backend
AUTH_JWKS_URL=http://localhost:8080/realms/idp/protocol/openid-connect/certs
# Defaults to true. Setting it to false is only permitted when
# APP_ENV=development; the server refuses to start otherwise.
AUTH_ENABLED=false
# Confidential client (idp-backend) used by Add Member to create Keycloak users.
AUTH_ADMIN_CLIENT_ID=idp-backend
AUTH_ADMIN_CLIENT_SECRET=idp-backend-dev-secret

# Kubernetes
KUBECONFIG=
KUBERNETES_IN_CLUSTER=false

# Ingress
# Generated hostnames follow <app>.<project>.<domain>. Set enabled=false on a
# cluster with no ingress controller, where every Ingress would sit unrouted
# while the UI advertised a URL that never resolves.
# minikube: minikube addons enable ingress
IDP_INGRESS_ENABLED=true
IDP_INGRESS_DOMAIN=idp.local
IDP_INGRESS_CLASS=nginx
# Attach a TLS secret to every generated Ingress; also switches URLs to https.
IDP_INGRESS_TLS_SECRET=

# Git build & deploy
# Build Jobs run Kaniko in their own namespace, kept apart from application
# namespaces so a build pod cannot read application Secrets.
IDP_BUILD_ENABLED=true
IDP_BUILD_NAMESPACE=idp-builds
IDP_BUILD_KANIKO_IMAGE=
IDP_BUILD_POLL_INTERVAL=10s
# Externally reachable base URL, used to render the webhook endpoint users
# paste into GitHub/GitLab/Bitbucket. Without it the UI shows a relative path.
IDP_PUBLIC_URL=

# Security
# 32-byte key (base64 or hex) used to encrypt registry passwords at rest.
# Generate with: openssl rand -base64 32
# Leave empty to disable registry credential storage entirely — the platform
# refuses to store passwords in plaintext rather than degrading silently.
# Changing this key makes every stored credential undecryptable; re-save them.
IDP_ENCRYPTION_KEY=

# CORS
# Exact-match allowlist of browser origins. Comma-separated. Wildcards are
# rejected at startup because responses carry credentials, and "*" combined
# with credentials is both unsafe and refused by every browser.
IDP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Application
APP_VERSION=0.1.0
APP_ENV=development
